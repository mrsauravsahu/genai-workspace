#!/usr/bin/env bash
#
# .friday/cleanup — remove the symlinks .friday/init creates. Run from the
# project root:
#
#     bash .friday/cleanup
#
# Only removes paths that are still symlinks; a path you turned back into a
# real file is left alone.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(dirname "$SCRIPT_DIR")"
cd "$ROOT"

LINKS=(
  "CLAUDE.md"
  ".mcp.json"
  ".claude/skills"
  ".claude/commands"
  ".claude/settings.json"
  ".cursorrules"
  "AGENTS.md"
)

for link in "${LINKS[@]}"; do
  if [ -L "$link" ]; then
    rm -f "$link"
    echo "removed $link"
  fi
done

# Codex skill/prompt links created by .friday/init (one symlink per entry,
# pointing back into .friday/). Only symlinks are removed; real files and the
# directories themselves are left alone.
for dir in ".agents/skills" "$HOME/.codex/prompts"; do
  [ -d "$dir" ] || continue
  for link in "$dir"/*; do
    [ -L "$link" ] || continue
    rm -f "$link"
    echo "removed $link"
  done
done

echo
echo "done. cleanup complete."
