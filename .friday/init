#!/usr/bin/env bash
#
# .friday/init — regenerate vendor skill/command symlinks from .gitmodules,
# then ask which AI tooling you use and symlink the canonical .friday/ files
# into the paths each tool reads.
#
# .friday/settings.json is the canonical settings file, written in Claude
# Code's schema. Claude Code reads it through a symlink; every other tool
# gets it translated into its own schema by the agent (see the note this
# script prints at the end).
#
# Run from the hub project root to bootstrap it:
#
#     bash .friday/init
#
# Run with a target dir to wire up another repo (e.g. one cloned under
# repos/<name>) to this hub's shared .friday/ instead of creating its own:
#
#     bash .friday/init repos/<name>
#
# The generated links are per-user setup, not project source — they're
# gitignored (see .gitignore). Idempotent: re-running fixes drifted links.
# Existing real (non-symlink) files are backed up to <file>.bak instead of
# being overwritten.

set -euo pipefail

# The hub is wherever this script physically lives — vendor symlinks and
# .friday/skills, .friday/commands always live here, regardless of which
# directory we're wiring tooling paths into.
FRIDAY_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(dirname "$FRIDAY_DIR")"

# Directory to wire tooling paths into. Defaults to the hub; pass a path
# (e.g. repos/<name>) to bootstrap a nested repo against the hub instead.
TARGET="$(cd "${1:-$ROOT}" && pwd)"

# relpath <target-dir> <from-dir> — both absolute, no trailing slash needed.
relpath() {
  local target="$1" common="$2" back=""
  while [ "${target#"$common"/}" = "$target" ] && [ "$common" != "/" ]; do
    common="$(dirname "$common")"
    back="../$back"
  done
  echo "$back${target#"$common"/}"
}

# link <target-under-.friday, e.g. ".friday/rules.md"> <link-path-relative-to-TARGET>
link() {
  local target="$1" link="$2"
  local linkpath="$TARGET/$link"
  mkdir -p "$(dirname "$linkpath")"
  local dest
  dest="$(relpath "$ROOT/$target" "$(dirname "$linkpath")")"

  if [ -L "$linkpath" ] && [ "$(readlink "$linkpath")" = "$dest" ]; then
    echo "ok    $link -> $dest"
    return
  fi

  # A real file/dir sits here — back it up before replacing.
  if [ -e "$linkpath" ] && [ ! -L "$linkpath" ]; then
    mv "$linkpath" "$linkpath.bak"
    echo "backup $link -> $link.bak"
  fi

  rm -f "$linkpath"
  ln -s "$dest" "$linkpath"
  echo "link  $link -> $dest"
}

# Regenerate .friday/skills/* and .friday/commands/* from every
# `fridaySymlink = <path>` entry in .gitmodules (see
# .friday/commands/friday-install.md). `git submodule add` always names a
# submodule after its path, so the repo name is the basename of the key's
# submodule path. The declared path's first component (skills/ or
# commands/) picks the bucket; its basename becomes the link name. These are
# pure generated links, so always safe to overwrite outright.
sync_vendor_symlinks() {
  [ -f "$ROOT/.gitmodules" ] || return 0
  mkdir -p "$FRIDAY_DIR/skills" "$FRIDAY_DIR/commands"

  git config -f "$ROOT/.gitmodules" --get-regexp '^submodule\..*\.fridaySymlink$' 2>/dev/null |
  while read -r key sympath; do
    # git always normalizes config variable names (the last dot-segment) to
    # lowercase, so match "fridaysymlink" here regardless of how it's
    # spelled in .gitmodules.
    local repo="${key#submodule.}"
    repo="${repo%.fridaysymlink}"
    repo="$(basename "$repo")"
    local bucket=skills
    case "$sympath" in commands/*) bucket=commands ;; esac
    local base dest
    base="$(basename "$sympath")"
    dest="../vendor/$repo/$sympath"
    ln -sfn "$dest" "$FRIDAY_DIR/$bucket/$base"
    echo "link  .friday/$bucket/$base -> $dest"
  done
}

ask() {
  local prompt="$1" reply
  read -r -p "$prompt [y/N] " reply
  [[ "$reply" =~ ^[Yy]$ ]]
}

sync_vendor_symlinks

echo
echo "Which AI tooling do you use in $TARGET?"
echo

# Tools picked below that need .friday/settings.json translated rather than
# symlinked — collected here so the closing note can name them.
TRANSLATE=()

if ask "Claude Code?"; then
  link ".friday/rules.md" "CLAUDE.md"
  link ".friday/mcp.json" ".mcp.json"
  link ".friday/skills" ".claude/skills"
  link ".friday/commands" ".claude/commands"
  # .friday/settings.json is already in Claude Code's schema — no translation.
  link ".friday/settings.json" ".claude/settings.json"
fi

if ask "Cursor?"; then
  link ".friday/rules.md" ".cursorrules"
  TRANSLATE+=("Cursor (.cursor/settings.json)")
fi

if ask "Codex CLI / OpenCode (AGENTS.md)?"; then
  link ".friday/rules.md" "AGENTS.md"
  TRANSLATE+=("Codex CLI / OpenCode (.codex/config.toml, .opencode/opencode.json)")
fi

echo
echo "done. bootstrap complete."

if [ ${#TRANSLATE[@]} -gt 0 ]; then
  echo
  echo "Settings still need translating for:"
  printf '  - %s\n' "${TRANSLATE[@]}"
  echo
  echo "Ask your agent, from $TARGET:"
  echo
  echo "  Translate .friday/settings.json (Claude Code schema) into the"
  echo "  equivalent settings for the tools listed above, writing each to that"
  echo "  tool's own config path. Drop options with no equivalent rather than"
  echo "  inventing keys, and say which ones you dropped."
fi
