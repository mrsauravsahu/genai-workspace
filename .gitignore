snippets/
repos/
.envrc
agent.envrc

# .friday/bootstrap.sh generates these as per-user symlinks; .friday/ is
# the source of truth, not these paths.
/CLAUDE.md
/AGENTS.md
/.cursorrules
/.mcp.json
/.claude/skills
/.claude/commands
/.claude/settings.json
*.bak

# .friday/skills and .friday/commands mix vendored symlinks (regenerated by
# .friday/init, not source) with locally authored ones (source, tracked).
# Only the "friday-" prefixed entries are ours; ignore everything else.
/.friday/skills/*
!/.friday/skills/friday-*
/.friday/commands/*
!/.friday/commands/friday-*

.friday/**/*.pdf
.pdf
.DS_Store

friday-research
